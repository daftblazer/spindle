<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="SpindleWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Spindle</property>
    <property name="default-width">1400</property>
    <property name="default-height">880</property>
    <property name="width-request">360</property>
    <property name="height-request">400</property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 1100sp</condition>
        <setter object="inspector_split" property="collapsed">True</setter>
      </object>
    </child>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 760sp</condition>
        <setter object="inspector_split" property="collapsed">True</setter>
        <setter object="sidebar_split" property="collapsed">True</setter>
      </object>
    </child>
    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwOverlaySplitView" id="sidebar_split">
            <property name="sidebar-width-fraction">0.18</property>
            <property name="min-sidebar-width">200</property>
            <property name="max-sidebar-width">280</property>
            <property name="show-sidebar" bind-source="sidebar_button" bind-property="active" bind-flags="sync-create|bidirectional"/>
            <property name="sidebar">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="show-title">False</property>
                    <child type="start">
                      <object class="GtkMenuButton">
                        <property name="icon-name">list-add-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Add</property>
                        <property name="menu-model">add_menu</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkMenuButton">
                        <property name="primary">True</property>
                        <property name="icon-name">open-menu-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Main Menu</property>
                        <property name="menu-model">primary_menu</property>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="content">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="child">
                      <object class="GtkBox" id="sidebar_box">
                        <property name="orientation">vertical</property>
                      </object>
                    </property>
                  </object>
                </property>
                <child type="bottom">
                  <object class="GtkButton">
                    <property name="action-name">win.disc-settings</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">12</property>
                    <style>
                      <class name="flat"/>
                    </style>
                    <property name="child">
                      <object class="AdwButtonContent">
                        <property name="icon-name">media-optical-symbolic</property>
                        <property name="label" translatable="yes">Disc Settings</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
            <property name="content">
              <object class="AdwOverlaySplitView" id="inspector_split">
                <property name="sidebar-position">end</property>
                <property name="sidebar-width-fraction">0.24</property>
                <property name="min-sidebar-width">280</property>
                <property name="max-sidebar-width">380</property>
                <property name="show-sidebar" bind-source="inspector_button" bind-property="active" bind-flags="sync-create|bidirectional"/>
                <property name="content">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <child type="start">
                          <object class="GtkToggleButton" id="sidebar_button">
                            <property name="icon-name">sidebar-show-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Toggle Sidebar</property>
                            <property name="active">True</property>
                          </object>
                        </child>
                        <child type="start">
                          <object class="GtkBox">
                            <style>
                              <class name="linked"/>
                            </style>
                            <child>
                              <object class="GtkButton">
                                <property name="icon-name">edit-undo-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Undo</property>
                                <property name="action-name">win.undo</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton">
                                <property name="icon-name">edit-redo-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Redo</property>
                                <property name="action-name">win.redo</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <property name="title-widget">
                          <object class="AdwWindowTitle" id="window_title">
                            <property name="title" translatable="yes">Spindle</property>
                          </object>
                        </property>
                        <child type="end">
                          <object class="GtkToggleButton" id="inspector_button">
                            <property name="icon-name">sidebar-show-right-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Toggle Inspector</property>
                            <property name="active">True</property>
                          </object>
                        </child>
                        <child type="end">
                          <object class="GtkButton">
                            <property name="action-name">win.build</property>
                            <property name="tooltip-text" translatable="yes">Build Blu-ray Disc</property>
                            <style>
                              <class name="suggested-action"/>
                            </style>
                            <property name="child">
                              <object class="AdwButtonContent">
                                <property name="icon-name">media-optical-symbolic</property>
                                <property name="label" translatable="yes">_Build Disc</property>
                                <property name="use-underline">True</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="top">
                      <object class="AdwBanner" id="missing_banner">
                        <property name="button-label" translatable="yes">_Locate…</property>
                        <property name="action-name">win.locate-media</property>
                      </object>
                    </child>
                    <property name="content">
                      <object class="GtkPaned" id="center_paned">
                        <property name="orientation">vertical</property>
                        <property name="resize-start-child">True</property>
                        <property name="resize-end-child">False</property>
                        <property name="shrink-end-child">False</property>
                        <property name="start-child">
                          <object class="GtkStack" id="center_stack">
                            <property name="transition-type">crossfade</property>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">empty</property>
                                <property name="child">
                                  <object class="AdwStatusPage">
                                    <property name="icon-name">media-optical-symbolic</property>
                                    <property name="title" translatable="yes">No Menu or Title Selected</property>
                                    <property name="description" translatable="yes">Import videos, then drag them onto a menu to create buttons</property>
                                    <property name="child">
                                      <object class="GtkButton">
                                        <property name="label" translatable="yes">_Import Media…</property>
                                        <property name="use-underline">True</property>
                                        <property name="halign">center</property>
                                        <property name="action-name">win.import</property>
                                        <style>
                                          <class name="pill"/>
                                          <class name="suggested-action"/>
                                        </style>
                                      </object>
                                    </property>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">menu</property>
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <child>
                                      <object class="GtkBox" id="canvas_toolbar">
                                        <property name="spacing">6</property>
                                        <property name="margin-start">12</property>
                                        <property name="margin-end">12</property>
                                        <property name="margin-top">6</property>
                                        <property name="margin-bottom">6</property>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="action-name">win.add-button</property>
                                            <property name="tooltip-text" translatable="yes">Add Button</property>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                            <property name="child">
                                              <object class="AdwButtonContent">
                                                <property name="icon-name">input-mouse-symbolic</property>
                                                <property name="label" translatable="yes">Button</property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="action-name">win.add-text</property>
                                            <property name="tooltip-text" translatable="yes">Add Text</property>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                            <property name="child">
                                              <object class="AdwButtonContent">
                                                <property name="icon-name">format-text-rich-symbolic</property>
                                                <property name="label" translatable="yes">Text</property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="action-name">win.add-image</property>
                                            <property name="tooltip-text" translatable="yes">Add an Image, such as a Logo</property>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                            <property name="child">
                                              <object class="AdwButtonContent">
                                                <property name="icon-name">image-x-generic-symbolic</property>
                                                <property name="label" translatable="yes">Image</property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="action-name">win.add-button-grid</property>
                                            <property name="tooltip-text" translatable="yes">Add a button for every title</property>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                            <property name="child">
                                              <object class="AdwButtonContent">
                                                <property name="icon-name">view-grid-symbolic</property>
                                                <property name="label" translatable="yes">All Titles</property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="action-name">win.templates</property>
                                            <property name="tooltip-text" translatable="yes">Create Menus From a Template (Ctrl+T)</property>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                            <property name="child">
                                              <object class="AdwButtonContent">
                                                <property name="icon-name">folder-templates-symbolic</property>
                                                <property name="label" translatable="yes">Templates</property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSeparator">
                                            <property name="hexpand">True</property>
                                            <style>
                                              <class name="spacer"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkToggleButton" id="highlight_button">
                                            <property name="action-name">win.remote-preview</property>
                                            <property name="tooltip-text" translatable="yes">Try the Menu With a Remote (F5)</property>
                                            <property name="child">
                                              <object class="AdwButtonContent">
                                                <property name="icon-name">media-playback-start-symbolic</property>
                                                <property name="label" translatable="yes">Preview</property>
                                              </object>
                                            </property>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkToggleButton" id="grid_button">
                                            <property name="icon-name">view-grid-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Snap to Grid</property>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkToggleButton" id="safe_area_button">
                                            <property name="icon-name">spindle-safe-area-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Show Safe Area</property>
                                            <property name="active">True</property>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="canvas_box">
                                        <property name="vexpand">True</property>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">title</property>
                                <property name="child">
                                  <object class="GtkBox" id="title_box">
                                    <property name="orientation">vertical</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </property>
                        <property name="end-child">
                          <object class="GtkBox" id="media_box">
                            <property name="orientation">vertical</property>
                            <property name="height-request">190</property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
                <property name="sidebar">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="show-title">True</property>
                        <property name="title-widget">
                          <object class="AdwWindowTitle" id="inspector_title">
                            <property name="title" translatable="yes">Properties</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <property name="content">
                      <object class="GtkBox" id="inspector_box">
                        <property name="orientation">vertical</property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
  <menu id="add_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Import Media…</attribute>
        <attribute name="action">win.import</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Menus From _Template…</attribute>
        <attribute name="action">win.templates</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">New _Menu</attribute>
        <attribute name="action">win.add-menu</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">New _Pop-up Menu</attribute>
        <attribute name="action">win.add-popup-menu</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Chapter Menu for Selected Title</attribute>
        <attribute name="action">win.add-chapter-menu</attribute>
      </item>
    </section>
  </menu>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_New Project</attribute>
        <attribute name="action">win.new</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Open…</attribute>
        <attribute name="action">win.open</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Save</attribute>
        <attribute name="action">win.save</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Save _As…</attribute>
        <attribute name="action">win.save-as</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Menu _Templates…</attribute>
        <attribute name="action">win.templates</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Disc Settings</attribute>
        <attribute name="action">win.disc-settings</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Spindle</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
