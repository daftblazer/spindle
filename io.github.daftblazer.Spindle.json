{
    "id": "io.github.daftblazer.Spindle",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "spindle",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=all",
        "--filesystem=host"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "build-args": [
            "--share=network"
        ],
        "env": {
            "RUST_BACKTRACE": "1",
            "RUST_LOG": "spindle=debug"
        }
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "/share/ffmpeg",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "libass",
            "config-opts": [
                "--disable-static",
                "--enable-fontconfig"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libass/libass/releases/download/0.17.4/libass-0.17.4.tar.xz",
                    "sha256": "78f1179b838d025e9c26e8fef33f8092f65611444ffa1bfc0cfac6a33511a05a"
                }
            ]
        },
        {
            "name": "x264",
            "config-opts": [
                "--enable-shared",
                "--enable-pic",
                "--disable-cli"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://code.videolan.org/videolan/x264.git",
                    "commit": "b35605ace3ddf7c1a5d67a2eb553f034aef41d55"
                }
            ]
        },
        {
            "name": "zimg",
            "config-opts": ["--disable-static"],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/sekrit-twc/zimg/archive/refs/tags/release-3.0.6.tar.gz",
                    "sha256": "be89390f13a5c9b2388ce0f44a5e89364a20c1c57ce46d382b1fcc3967057577"
                }
            ]
        },
        {
            "name": "nv-codec-headers",
            "cleanup": ["*"],
            "no-autogen": true,
            "make-install-args": ["PREFIX=/app"],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/FFmpeg/nv-codec-headers.git",
                    "tag": "n12.2.72.0",
                    "commit": "c69278340ab1d5559c7d7bf0edf615dc33ddbba7"
                }
            ]
        },
        {
            "name": "xorriso",
            "config-opts": ["--disable-static"],
            "cleanup": ["/share/man", "/share/info"],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://ftp.gnu.org/gnu/xorriso/xorriso-1.5.8.pl02.tar.gz",
                    "mirror-urls": [
                        "https://ftpmirror.gnu.org/xorriso/xorriso-1.5.8.pl02.tar.gz",
                        "https://mirrors.kernel.org/gnu/xorriso/xorriso-1.5.8.pl02.tar.gz",
                        "https://www.gnu.org/software/xorriso/xorriso-1.5.8.pl02.tar.gz"
                    ],
                    "sha256": "b1455ecafbf0692ddafe1d71002a96f2ce2d77f4deae602678261ce033f97bc8"
                }
            ]
        },
        {
            "name": "ffmpeg",
            "config-opts": [
                "--enable-gpl",
                "--enable-libx264",
                "--enable-libzimg",
                "--enable-vaapi",
                "--enable-nvenc",
                "--enable-shared",
                "--disable-static",
                "--disable-doc",
                "--disable-ffplay"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://ffmpeg.org/releases/ffmpeg-8.1.3.tar.xz",
                    "sha256": "7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3"
                }
            ]
        },
        {
            "name": "spindle",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
